# Copiază acest fișier în `.env` sau `.env.local`. Cheile sunt citite doar server-side de `server/api.mjs`.
# Google Places este necesar pentru review-uri, competitori și context local extern.
GOOGLE_MAPS_API_KEY=
# OpenAI este folosit pentru analiza AI a review-urilor după ce Google Places livrează datele de bază.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPP_API_PORT=8787
